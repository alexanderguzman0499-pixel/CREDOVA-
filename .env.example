# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketmarket?schema=public"

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Social login (optional) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Authorized redirect URI:
# https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID="..."
AUTH_GOOGLE_SECRET="..."
# Meta for Developers -> your app -> Facebook Login -> Settings. Valid OAuth
# Redirect URI: https://<your-domain>/api/auth/callback/facebook
AUTH_FACEBOOK_ID="..."
AUTH_FACEBOOK_SECRET="..."

# --- Stripe ---
# https://dashboard.stripe.com/apikeys (use test keys while developing)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# https://dashboard.stripe.com/webhooks -> signing secret for the /api/webhooks/stripe endpoint
STRIPE_WEBHOOK_SECRET="whsec_..."
# Public base URL used to build Stripe Connect onboarding return/refresh links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Ticket file storage ---
# Local disk (dev only — no persistent disk on serverless, so this MUST be
# replaced by R2 below in any real deployment):
UPLOADS_DIR="./uploads"

# Cloudflare R2 (production). When these are set, src/lib/storage.ts uploads
# there instead of local disk. Create a private bucket + API token at
# https://dash.cloudflare.com -> R2 Object Storage -> Manage R2 API Tokens.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="ticket-files"

# --- Escrow release cron (see vercel.json) ---
# Set the same value in your Vercel project's env vars. Vercel automatically
# sends it as `Authorization: Bearer <value>` when it calls scheduled cron
# routes, so this is what authenticates /api/cron/release-escrow. Generate
# with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-secret"

# --- Transactional email (Resend) ---
# https://resend.com -> API Keys. Without this set, src/lib/email.ts logs a
# warning and skips sending instead of crashing (safe to leave unset in dev).
RESEND_API_KEY="re_..."
# Must be on a domain you've verified in Resend (Domains -> Add Domain -> add
# the DNS records they give you). Falls back to a sensible default if unset.
EMAIL_FROM="Global Ticket Resale <notifications@globalticketresale.com>"

# --- Admin access ---
# Comma-separated list of emails allowed into /admin (bulk event import,
# test-data cleanup). Must match the email on the account signing in.
ADMIN_EMAILS="you@example.com"
